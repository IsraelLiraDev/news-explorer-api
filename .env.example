# Em produção: obrigatório (no servidor). Em desenvolvimento: opcional;
# sem MONGO_URL usa o MongoDB local, ou coloque aqui a URL do MongoDB Atlas.
NODE_ENV=production
JWT_SECRET=troque-por-uma-chave-secreta-longa
MONGO_URL=mongodb://127.0.0.1:27017/news-explorer-db
PORT=3000
# Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com
